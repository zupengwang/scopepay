HOST=127.0.0.1
PORT=4181
APP_ORIGIN=http://127.0.0.1:4181
# Required for any non-loopback deployment. Use at least 12 characters.
ADMIN_PASSWORD=
# Optional persistent signing secret (at least 32 characters).
ADMIN_SESSION_SECRET=
DATA_PATH=./data/scopepay.sqlite
# sandbox only; never use live PayPal credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Select anthropic (Messages API) or openai (compatible Chat Completions).
SCOPEPAY_AI_API=anthropic
# Credentials stay on the server. For a local Qwen server, see README.
# Existing ANTHROPIC_AUTH_TOKEN, ANTHROPIC_BASE_URL, ANTHROPIC_MODEL are also supported.
# Defaults to https://api.anthropic.com when no base URL is configured.
SCOPEPAY_AI_BASE_URL=
SCOPEPAY_AI_KEY=
SCOPEPAY_AI_MODEL=
# Increase for CPU inference; allowed range: 1000–300000 ms.
SCOPEPAY_AI_TIMEOUT_MS=60000
